# ── LLM（OpenAI 兼容协议；留空则自动走本地规则兜底，不联网也能演示）────────────
# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 数据库（默认 SQLite，零配置；换 MySQL 改成 mysql+aiomysql://user:pwd@127.0.0.1:3306/customer_service）──
DATABASE_URL=sqlite+aiosqlite:///./customer_service.db

# ── 电商中台（模拟业务后端）──────────────────────────────────────────────────
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# ── 服务监听 ────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=18082
